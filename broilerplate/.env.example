# ==============================================================================
# FairyGift Environment Variables (.env.local)
# ==============================================================================

# 1. Public Storefront & WhatsApp Admin
# Format internasional tanpa "+" atau spasi, contoh: 6281234567890
NEXT_PUBLIC_WHATSAPP_ADMIN_NUMBER=6281234567890
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Firebase Client SDK (Project Settings -> General -> Your apps -> Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 3. Firebase Admin SDK (Project Settings -> Service accounts -> Generate new private key)
# Simpan PRIVATE KEY dalam satu baris dengan "\n" atau diapit tanda kutip ganda
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 4. Cloudinary (Dashboard -> Programmable Media -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 5. Seed Helper Secret (hanya dipakai saat inisialisasi data awal)
SEED_SECRET=fairygift-dev-seed
